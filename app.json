{
  "expo": {
    "name": "Atölye Defteri",
    "slug": "tekstil",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tekstil",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tekstil.takip",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Çalışan fotoğrafı eklemek için galerinize erişim gerekir.",
        "NSFaceIDUsageDescription": "Uygulama kilidi için Face ID kullanılır."
      }
    },
    "android": {
      "package": "com.tekstil.takip",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#2D54CD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Çalışan fotoğrafı eklemek için galerinize erişim gerekir.",
          "cameraPermission": "Çalışan fotoğrafı çekmek için kameraya erişim gerekir."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidi için Face ID kullanılır."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "247794cf-d62d-4bf6-b474-25b7510deb34"
      },
      "router": {}
    },
    "owner": "mzsoft"
  }
}
