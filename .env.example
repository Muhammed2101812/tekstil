# Supabase bağlantısı — doldurulmazsa uygulama "cihaz modunda" çalışır
# (tüm veri yalnızca telefonda tutulur, bulut senkronu olmaz).
# Değerler: Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google ile Giriş — Google Cloud Console > APIs & Services > Credentials > Web Application Client ID
# (Gizli anahtar değildir, client tarafında kullanılabilir)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
